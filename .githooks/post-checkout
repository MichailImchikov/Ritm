#!/bin/sh
# After git checkout / git switch: $1 old HEAD, $2 new HEAD, $3 is 1 for a branch switch (0 for file checkout)
[ "$3" = 1 ] || exit 0
# Rebase checks out its base on the way; post-rewrite rebuilds once it finishes
gitdir=$(git rev-parse --git-dir)
[ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] && exit 0
. "$(dirname "$0")/ritm-rebuild.sh"
ritm_rebuild "$1" "$2" "checkout"
exit 0
